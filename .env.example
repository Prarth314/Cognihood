# Supabase (publishable key works as VITE_SUPABASE_ANON_KEY)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# GEMINI_API_KEY is a server secret. Set it with:
# supabase secrets set GEMINI_API_KEY=... ALLOWED_ORIGINS=http://localhost:3000
# Never expose it through a VITE_ variable or commit it to this file.
