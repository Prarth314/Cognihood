# Browser variables: copy these to .env.local for local development and add the
# same VITE_* values in Vercel Project Settings -> Environment Variables.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here
VITE_ENABLE_EXPERIMENTAL_MOTION=false
VITE_ENABLE_HARDWARE_BRIDGE=false

# Supabase Edge Function secrets. Do NOT put these in Vercel or any VITE_* value.
# SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY are normally
# injected automatically by Supabase. Set the remaining values with:
# supabase secrets set GEMINI_API_KEY=... GEMINI_MODEL=gemini-3.8-flash \
#   ALLOWED_ORIGINS=https://your-domain.example,http://localhost:3000 \
#   AI_RATE_LIMIT_PER_MINUTE=15 AI_DAILY_LIMIT=2500
GEMINI_API_KEY=replace_with_a_new_rotated_server_key
GEMINI_MODEL=gemini-3.8-flash
ALLOWED_ORIGINS=http://localhost:3000
AI_RATE_LIMIT_PER_MINUTE=15
AI_DAILY_LIMIT=2500
AI_GLOBAL_DAILY_LIMIT=100000

# Optional Vercel CLI metadata. Vercel creates .vercel/project.json after linking;
# these values are for CI scripts only and are not used by the browser app.
VERCEL_ORG_ID=replace_with_cognihood_team_id
VERCEL_PROJECT_ID=replace_after_project_creation
VERCEL_TOKEN=use_only_in_a_private_ci_secret_store
