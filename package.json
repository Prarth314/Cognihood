{
  "name": "cognihood-driver-safety-system",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "engines": {
    "node": ">=22 <25"
  },
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-vision-assets.mjs",
    "prebuild": "node scripts/copy-vision-assets.mjs",
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs && node scripts/verify-build.mjs",
    "preview": "vite preview",
    "start:pi": "node hardware/raspberry-pi/bridge.js",
    "build:test": "node scripts/copy-vision-assets.mjs && vite build --mode e2e && node scripts/prerender.mjs && node scripts/verify-build.mjs",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "security:audit": "npm audit",
    "check": "npm run typecheck && npm test && npm run build && npm run security:audit"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/analytics": "^2.0.1",
    "express": "4.22.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
